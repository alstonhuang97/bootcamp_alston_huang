# Hobby-Box EV Calculator — environment template.
# This project uses NO runtime secrets: the data is a manual transcription
# (data/raw/*.csv) and the API talks to nothing external. Copy to `.env` only
# if you want to override a default; nothing here is required to run.

# Port for the Flask API (app.py). Default 5001 (macOS AirPlay holds 5000).
# API_PORT=5001

# Base value assumed for one common base card, used by src/ev.py.
# EV_BASE_CARD_VALUE=0.20
